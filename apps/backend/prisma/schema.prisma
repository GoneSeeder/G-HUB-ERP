generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String              @id @default(uuid())
  username     String              @unique
  name         String
  passwordHash String
  isActive     Boolean             @default(true)
  roles        UserRole[]
  apps         UserAppPermission[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

model Role {
  id          String              @id @default(uuid())
  code        String              @unique
  name        String
  users       UserRole[]
  permissions RoleAppPermission[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model App {
  id          String              @id @default(uuid())
  code        String              @unique
  name        String
  description String?
  roleAccess  RoleAppPermission[]
  users       UserAppPermission[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RoleAppPermission {
  roleId    String
  appId     String
  canAccess Boolean @default(true)

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  app  App  @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@id([roleId, appId])
}

model UserAppPermission {
  userId     String
  appId      String
  canAccess  Boolean @default(true)
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  app  App  @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@id([userId, appId])
}

model BonusCard {
  id               String   @id @default(uuid())
  workDate         DateTime
  bonus            String
  bonusName        String
  agentCode        String
  agentName        String
  companyCode      String   @default("")
  guide            String
  guideName        String
  memberCode       String   @default("")
  supervisorCode   String   @default("")
  tourLeaderName   String   @default("")
  tourLeaderPassport String @default("")
  partyCode        String
  nation           String   @default("CN")
  province         String   @default("")
  adult            Int      @default(0)
  child            Int      @default(0)
  tourLeader       Int      @default(0)
  student          Int      @default(0)
  carCode          String   @default("")
  shop             String   @default("")
  charterCode      String   @default("")
  hotel            String   @default("")
  comeFrom         String   @default("")
  busType          String   @default("")
  tourIn           String   @default("")
  tourOut          String   @default("")
  recorder         String   @default("")
  recorderTime     String   @default("")
  comment          String   @default("")
  imageUrl         String?
  nameListCode     String   @default("")
  extraGuides      Json     @default("[]")
  narratorGroup    String   @default("")
  narratorPax      Int      @default(0)
  narrators        Json     @default("[]")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  lectureSessions  LectureSession[]
  lectureHistories LectureHistory[]
}

model ReferenceItem {
  id         String   @id @default(uuid())
  type       String
  code       String
  name       String
  secondaryName String @default("")
  nationCode String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([type, code, nationCode])
  @@index([type])
  @@index([type, nationCode])
}

model Member {
  id                     String    @id @default(uuid())
  guideCode              String    @unique
  titleTh                String    @default("")
  firstNameTh            String    @default("")
  lastNameTh             String    @default("")
  titleEn                String    @default("")
  firstNameEn            String    @default("")
  lastNameEn             String    @default("")
  phone                  String    @default("")
  nickname               String    @default("")
  birthDate              DateTime?
  nationalId             String    @default("")
  cardIssueDate          DateTime?
  cardExpireDate         DateTime?
  guideType              String    @default("")
  guideLicenseNo         String    @default("")
  guideLicenseExpireDate DateTime?
  passportNo             String    @default("")
  address                String    @default("")
  province               String    @default("")
  note                   String    @default("")
  recorder               String    @default("")
  fullName               String    @default("")
  fullNameTh             String    @default("")
  guideCardNo            String    @default("")
  company                String    @default("")
  guideHo                String    @default("")
  imageUrl               String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

model Agent {
  id            String       @id @default(uuid())
  agentCode     String       @unique
  codeCenter    String       @default("")
  name          String       @default("")
  address       String       @default("")
  nation        String       @default("")
  phone         String       @default("")
  fax           String       @default("")
  contactPerson String       @default("")
  marketing     String       @default("")
  agentHO       String       @default("")
  typeCenter    String       @default("")
  agentType     String       @default("AGENT")
  typeGroup     String       @default("")
  navCode       String       @default("")
  email         String       @default("")
  taxId         String       @default("")
  branch        String       @default("")
  bankName      String       @default("")
  bankBranch    String       @default("")
  bankAccount   String       @default("")
  active        Boolean      @default(true)
  aliases       AgentAlias[]
  matchings     AgentMatching[]
  bookings      Booking[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([name])
  @@index([nation])
  @@index([active])
  @@index([typeGroup])
}

model AgentAlias {
  id        String   @id @default(uuid())
  agentId   String
  pattern   String
  matchType String   @default("contains")
  createdAt DateTime @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, pattern, matchType])
  @@index([pattern])
}

model AgentMatching {
  id           String   @id @default(uuid())
  agentCodeRef String   @unique
  agentNameRef String   @default("")
  agentId      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([agentNameRef])
}

model NameList {
  id          String         @id @default(uuid())
  code        String         @unique
  partyCode   String         @default("")
  arriveDate  DateTime?
  departDate  DateTime?
  agentCode   String         @default("")
  agentName   String         @default("")
  guideCode   String         @default("")
  guideName   String         @default("")
  nationCode  String         @default("")
  nationName  String         @default("")
  country     String         @default("")
  province    String         @default("")
  busCode     String         @default("")
  pax         Int            @default(0)
  sourceFile  String         @default("")
  note        String         @default("")
  items       NameListItem[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([arriveDate])
  @@index([agentCode])
  @@index([partyCode])
  @@index([nationCode])
}

model NameListItem {
  id           String   @id @default(uuid())
  nameListId   String
  itemNo       Int      @default(0)
  isLeader     Boolean  @default(false)
  agentCode    String   @default("")
  code         String   @default("")
  guideCode    String   @default("")
  guideName    String   @default("")
  arriveDate   DateTime?
  passportNo   String   @default("")
  firstName    String   @default("")
  lastName     String   @default("")
  birthDate    DateTime?
  age          Int?
  gender       String   @default("")
  nationCode   String   @default("")
  province     String   @default("")
  location     String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  nameList NameList @relation(fields: [nameListId], references: [id], onDelete: Cascade)

  @@index([nameListId])
  @@index([passportNo])
  @@index([code])
}

model Booking {
  id           String             @id @default(uuid())
  importKey    String             @unique @default(uuid())
  docDate      DateTime
  docTime      String             @default("")
  docNo        String             @default("")
  agentCode    String             @default("")
  agentId      String?
  agentName    String             @default("")
  partyCode    String             @default("")
  nation       String             @default("")
  arriveDate   DateTime?
  departDate   DateTime?
  guideCode    String             @default("")
  guideName    String             @default("")
  telGuide     String             @default("")
  telDriver    String             @default("")
  pax          Int                @default(0)
  carCode      String             @default("")
  shop         String             @default("")
  bookRemark   String             @default("")
  dateBookJw   DateTime?
  timeBookJw   String             @default("")
  ptyStartDate DateTime?
  ptyEndDate   DateTime?
  faxNo        String             @default("")
  agentCodeRef String             @default("")
  partyCodeRef String             @default("")
  bonusCode    String             @default("")
  status       Boolean            @default(false)
  upload       Boolean            @default(false)
  references   BookingReference[]
  agent        Agent?             @relation(fields: [agentId], references: [id], onDelete: SetNull)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([docDate])
  @@index([agentCode])
  @@index([agentId])
  @@index([nation])
  @@index([status])
  @@index([upload])
  @@index([bonusCode])
}

model BookingReference {
  id        String    @id @default(uuid())
  bookingId String
  orderDate DateTime?
  faxNo     String    @default("")
  agentCode String    @default("")
  code      String    @default("")
  place     String    @default("")
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime  @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([faxNo])
}

model LectureRoom {
  id        String   @id @default(uuid())
  roomCode  String   @unique
  roomName  String
  capacity  Int
  status    String   @default("available") // "available" | "inactive"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activeSession LectureSession?
}

model Speaker {
  id          String   @id @default(uuid())
  speakerCode String   @unique
  speakerName String
  status      String   @default("available") // "available" | "lecturing" | "inactive"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  activeSessions LectureSession[]
}

model LectureSession {
  id            String    @id @default(uuid())
  partyCode     String
  bonusCardId   String?
  roomId        String    @unique
  roomCode      String
  roomName      String
  speakerId     String
  speakerCode   String
  speakerName   String
  speaker2Id    String?
  speaker2Code  String   @default("")
  speaker2Name  String   @default("")
  attendeeCount Int       @default(0)
  status        String    @default("arriving") // "arriving" | "lecturing" | "selling"
  startedAt     DateTime?
  lectureEndedAt DateTime?
  lectureDurationSeconds Int @default(0)
  cashierCode   String    @default("")
  salesAmount   Decimal   @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  room      LectureRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  speaker   Speaker     @relation(fields: [speakerId], references: [id], onDelete: Cascade)
  bonusCard BonusCard?  @relation(fields: [bonusCardId], references: [id], onDelete: SetNull)
}

model LectureHistory {
  id              String   @id @default(uuid())
  partyCode       String
  bonusCardId     String?
  roomId          String
  roomCode        String
  roomName        String
  speakerId       String
  speakerCode     String
  speakerName     String
  speaker2Id      String?
  speaker2Code    String   @default("")
  speaker2Name    String   @default("")
  attendeeCount   Int      @default(0)
  startedAt       DateTime
  endedAt         DateTime
  lectureEndedAt  DateTime?
  lectureDurationSeconds Int @default(0)
  totalDurationSeconds Int @default(0)
  durationSeconds Int
  cashierCode     String   @default("")
  salesAmount     Decimal  @default(0)
  createdAt       DateTime @default(now())

  bonusCard BonusCard? @relation(fields: [bonusCardId], references: [id], onDelete: SetNull)
}

// ──────────────────────────────────────────────────────────────────────────────
// HUMANSOURCE (HR) — added 2026-06-27. See HR_BACKEND_PLAN.md.
// Slice 0: core master tables + denormalized Employee (frozen frontend contract).
// Employee *Id columns are soft references (no enforced FK yet) — relations get
// added in a later slice after the position/employee-type taxonomy is reconciled.
// ──────────────────────────────────────────────────────────────────────────────

model HrOrgNode {
  id       String      @id
  name     String
  type     String      // company | branch | department | team
  code     String?
  active   Boolean     @default(true)
  parentId String?
  parent   HrOrgNode?  @relation("HrOrgTree", fields: [parentId], references: [id], onDelete: SetNull)
  children HrOrgNode[] @relation("HrOrgTree")

  @@map("hr_org_node")
}

model HrCompany {
  id                 String  @id
  orgNodeId          String  @unique
  legalNameTh        String
  tradeName          String
  taxId              String
  socialSecurityCode String
  address            String?
  active             Boolean @default(true)
  workConditions     Json    @default("{}")

  @@map("hr_company")
}

model HrJobLevel {
  id     String  @id
  nameTh String
  nameEn String
  rank   Int
  active Boolean @default(true)

  @@map("hr_job_level")
}

model HrPosition {
  id               String  @id
  code             String
  nameTh           String
  nameEn           String
  level            String  // legacy display; use jobLevelId going forward
  jobLevelId       String  @default("")
  companyId        String  @default("")
  employeeTypes    Json    @default("[]")
  salaryMin        Int     @default(0)
  salaryMax        Int     @default(0)
  overview         String  @default("")
  responsibilities String  @default("")
  qualifications   String  @default("")
  hasBenefits      Boolean @default(false)
  active           Boolean @default(true)

  @@map("hr_position")
}

model HrEmployeeType {
  id     String  @id
  code   String
  nameTh String
  nameEn String
  tax    String
  active Boolean @default(true)

  @@map("hr_employee_type")
}

model HrShift {
  id                     String   @id
  code                   String   @unique
  name                   String
  type                   String   @default("")
  time                   String   @default("")
  companyScope           String   @default("")
  groupKey               String   @default("same-day")
  enabled                Boolean  @default(true)
  description            String?
  timezone               String?
  color                  String?
  attendanceRule         String?
  flexibleEntryEnabled   Boolean?
  flexibleMinutes        Int?
  minimumWorkHours       Float?
  trackBreak             Boolean?
  shiftAllowanceEnabled  Boolean?
  shiftAllowanceAmount   Float?
  prorateShiftAllowance  Boolean?
  holidayPremiumEnabled  Boolean?
  overtimePremiumEnabled Boolean?
  updatedBy              String?
  updatedAt              DateTime @updatedAt

  @@map("hr_shift")
}

model HrLeaveType {
  id          String  @id
  code        String  @unique
  nameTh      String
  nameEn      String  @default("")
  tag         String  @default("")
  color       String  @default("#6366f1")
  unit        String  @default("day")
  statutory   Boolean @default(false)
  enabled     Boolean @default(true)
  rules       Json    @default("{}")
  eligibility Json    @default("{}")
  quota       Json    @default("{}")
  approval    Json    @default("{}")

  @@map("hr_leave_type")
}

model HrDocumentApprovalConfig {
  docType   String @id
  labelTh   String
  mechanism String @default("position_structure")
  steps     String @default("1")

  @@map("hr_document_approval_config")
}

model HrPersonApprover {
  employeeId String  @id
  approverId String?

  @@map("hr_person_approver")
}

model HrHolidayCalendar {
  id        String           @id
  name      String
  color     String
  isDefault Boolean          @default(false)
  entries   HrHolidayEntry[]

  @@map("hr_holiday_calendar")
}

model HrHolidayEntry {
  id          String            @id
  calendarId  String
  calendar    HrHolidayCalendar @relation(fields: [calendarId], references: [id])
  year        Int
  date        String
  title       String
  type        String            @default("company")
  country     String            @default("")
  appliesTo   String            @default("")
  description String            @default("")
  source      String            @default("custom")

  @@index([calendarId, year])
  @@map("hr_holiday_entry")
}

model HrHolidayOverride {
  officialId  String   @id
  date        String?
  title       String?
  description String?
  type        String?
  deleted     Boolean  @default(false)

  @@map("hr_holiday_override")
}

model HrAnnouncementCategory {
  id            String           @id
  nameTh        String
  color         String
  active        Boolean          @default(true)
  announcements HrAnnouncement[]

  @@map("hr_announcement_category")
}

model HrAnnouncement {
  id          String                 @id @default(cuid())
  title       String
  bodyMd      String                 @default("")
  imageBase64 String                 @default("")
  attachments Json                   @default("[]")
  categoryId  String
  category    HrAnnouncementCategory @relation(fields: [categoryId], references: [id])
  audience    Json                   @default("{\"scope\":\"all\",\"companyIds\":[],\"orgNodeIds\":[],\"employeeTypeIds\":[],\"employeeIds\":[]}")
  status      String                 @default("draft")
  publishAt   String?
  publishEnd  String?
  pinned      Boolean                @default(false)

  @@map("hr_announcement")
}

model HrEmployeeDefaults {
  id                    String @id @default(cuid())
  codePrefix            String @default("EMP")
  codePadding           Int    @default(4)
  defaultEmployeeTypeId String @default("ET001")
  defaultStatus         String @default("NORMAL")
  startDateMode         String @default("today")

  @@map("hr_employee_defaults")
}

model HrRunningNumberConfig {
  id         String  @id
  docLabelTh String
  prefix     String
  dateToken  String  @default("none")
  padding    Int     @default(4)
  nextNumber Int     @default(1)
  active     Boolean @default(true)

  @@map("hr_running_number_config")
}

model HrMasterOption {
  id       String  @id
  category String
  nameTh   String
  nameEn   String  @default("")
  active   Boolean @default(true)

  @@index([category])
  @@map("hr_master_option")
}

model HrJsonStore {
  key   String @id
  value Json   @default("{}")

  @@map("hr_json_store")
}

model HrPayrollGeneralConfig {
  id                 String  @id @default(cuid())
  cycleStartDay      String  @default("1")
  cycleEndDay        String  @default("EOM")
  ssoEmployeeRate    Float   @default(5)
  ssoEmployerRate    Float   @default(5)
  ssoMonthlyWageFloor Float  @default(1650)
  ssoMonthlyWageCap  Float   @default(17500)
  ssoIncludeOT       Boolean @default(true)
  ssoIncludeBonus    Boolean @default(true)
  ssoIncludeWelfare  Boolean @default(true)
  currency           String  @default("THB")
  moneyRounding      String  @default("nearest-baht")
  preventWrongOtType Boolean @default(true)

  @@map("hr_payroll_general_config")
}

model HrPayrollEmploymentType {
  id                String  @id
  code              String
  nameTh            String
  nameEn            String  @default("")
  payType           String
  paidPublicHoliday Boolean @default(true)
  paidHourly        Boolean @default(false)
  calcConditions    Json    @default("[]")
  employeeTypeId    String?
  active            Boolean @default(true)

  @@map("hr_payroll_employment_type")
}

model HrPayItem {
  id                   String   @id
  kind                 String
  code                 String
  nameTh               String
  nameEn               String   @default("")
  revenueCategory      String?
  rounding             String   @default("none")
  taxCalcMethod        String?
  payoutScope          String   @default("every-period")
  taxable              Boolean  @default(false)
  linkSSO              Boolean  @default(false)
  linkProvidentFund    Boolean  @default(false)
  offCycle             Boolean  @default(false)
  carryPrevPeriod      Boolean  @default(false)
  payOnce              Boolean?
  payoutScopeOnce      Boolean?
  calcByActualWorkdays Boolean?
  linkOvertime         Boolean?
  linkLateAbsent       Boolean?
  isWelfare            Boolean  @default(false)
  enabled              Boolean  @default(true)
  isSystem             Boolean  @default(false)
  isCustom             Boolean  @default(false)
  accountMapping       Json     @default("{}")

  @@map("hr_pay_item")
}

model HrAccountCategory {
  id        String   @id
  nameTh    String
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@map("hr_account_category")
}

model HrPayPeriodConfig {
  id                 String              @id @default(cuid())
  year               Int
  frequency          String              @default("monthly")
  firstPeriodStart   String
  payDayOfMonth      String              @default("EOM")
  payNextMonth       Boolean             @default(false)
  payBeforeIfHoliday Boolean             @default(false)
  hasOffCycle        Boolean             @default(false)
  offCycleStart      String?
  employmentTypeIds  Json                @default("[]")
  generatedPeriods   HrGeneratedPeriod[]

  @@map("hr_pay_period_config")
}

model HrGeneratedPeriod {
  id          String            @id
  configId    String
  config      HrPayPeriodConfig @relation(fields: [configId], references: [id])
  index       Int
  label       String
  periodStart String
  periodEnd   String
  payDate     String

  @@map("hr_generated_period")
}

model HrEmployee {
  id               String   @id
  code             String   @unique
  name             String
  email            String
  phone            String
  position         String
  department       String
  branch           String
  empType          String
  schedule         String
  startDate        String
  salary           Int
  status           String
  active           Boolean  @default(true)
  companyId        String
  branchNodeId     String
  departmentNodeId String
  positionId       String
  employeeTypeId   String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([branchNodeId])
  @@index([departmentNodeId])
  @@map("hr_employee")
}

model HrAccount {
  id               String   @id @default(cuid())
  email            String   @unique
  displayName      String
  passwordHash     String
  authSource       String   @default("hr")
  accountStatus    String   @default("pending")
  membershipStatus String   @default("none")
  hasGhubLink      Boolean  @default(false)
  employeeId       String?  @unique
  userId           String?
  createdAt        DateTime @default(now())
  linkCodes        HrLinkCode[]

  @@map("hr_account")
}

model HrLinkCode {
  id        String    @id @default(cuid())
  code      String    @unique
  accountId String
  account   HrAccount @relation(fields: [accountId], references: [id])
  used      Boolean   @default(false)
  expiresAt DateTime

  @@map("hr_link_code")
}

// ─────────────────────────────────────────────────────────────
// LAYER B — RUNTIME / TRANSACTIONAL
// ─────────────────────────────────────────────────────────────

model HrShiftAssignment {
  id         String   @id @default(cuid())
  employeeId String
  date       String   // YYYY-MM-DD
  shiftId    String?
  isOff      Boolean  @default(false)
  note       String?
  createdAt  DateTime @default(now())

  @@unique([employeeId, date])
  @@index([date])
  @@index([employeeId])
  @@map("hr_shift_assignment")
}

model HrAttendanceRecord {
  id         String   @id @default(cuid())
  employeeId String
  date       String   // YYYY-MM-DD
  clockIn    String?  // HH:MM or full ISO
  clockOut   String?
  source     String   @default("manual") // 'scan' | 'manual' | 'mobile'
  lat        Float?
  lng        Float?
  note       String?
  createdAt  DateTime @default(now())

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
  @@map("hr_attendance_record")
}

model HrLeaveRequest {
  id          String   @id @default(cuid())
  employeeId  String
  leaveTypeId String
  startDate   String   // YYYY-MM-DD
  endDate     String
  unitCount   Float
  reason      String?
  status      String   @default("pending") // draft|pending|approved|rejected|cancelled
  attachments Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  approval    HrApprovalInstance?

  @@index([employeeId])
  @@index([status])
  @@map("hr_leave_request")
}

model HrLeaveBalance {
  id          String @id @default(cuid())
  employeeId  String
  leaveTypeId String
  year        Int
  entitled    Float  @default(0)
  used        Float  @default(0)
  carriedOver Float  @default(0)

  @@unique([employeeId, leaveTypeId, year])
  @@index([employeeId])
  @@map("hr_leave_balance")
}

model HrDocumentRequest {
  id         String   @id @default(cuid())
  docType    String   // 'ot' | 'time-adjust' | 'cert' | 'petty-cash' | ...
  employeeId String
  payload    Json     @default("{}")
  status     String   @default("pending") // draft|pending|approved|rejected
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  approval   HrApprovalInstance?

  @@index([employeeId])
  @@index([docType, status])
  @@map("hr_document_request")
}

model HrApprovalInstance {
  id             String  @id @default(cuid())
  docType        String
  leaveRequestId String? @unique
  leaveRequest   HrLeaveRequest?   @relation(fields: [leaveRequestId], references: [id])
  docRequestId   String? @unique
  docRequest     HrDocumentRequest? @relation(fields: [docRequestId], references: [id])
  state          String  @default("pending") // pending|approved|rejected
  createdAt      DateTime @default(now())
  steps          HrApprovalStep[]

  @@map("hr_approval_instance")
}

model HrApprovalStep {
  id         String   @id @default(cuid())
  instanceId String
  instance   HrApprovalInstance @relation(fields: [instanceId], references: [id])
  stepOrder  Int
  approverId String
  state      String   @default("pending")
  actedAt    DateTime?
  comment    String?

  @@index([instanceId])
  @@map("hr_approval_step")
}

model HrPayrollRun {
  id        String   @id @default(cuid())
  periodId  String
  status    String   @default("draft") // draft|calculated|approved|paid
  createdAt DateTime @default(now())
  payslips  HrPayslip[]

  @@index([periodId])
  @@map("hr_payroll_run")
}

model HrPayslip {
  id         String      @id @default(cuid())
  runId      String
  run        HrPayrollRun @relation(fields: [runId], references: [id])
  employeeId String
  gross      Float       @default(0)
  deductions Float       @default(0)
  net        Float       @default(0)
  lines      Json        @default("[]")

  @@unique([runId, employeeId])
  @@index([employeeId])
  @@map("hr_payslip")
}
