generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String              @id @default(uuid())
  username     String              @unique
  name         String
  passwordHash String
  isActive     Boolean             @default(true)
  roles        UserRole[]
  apps         UserAppPermission[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

model Role {
  id          String              @id @default(uuid())
  code        String              @unique
  name        String
  users       UserRole[]
  permissions RoleAppPermission[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model App {
  id          String              @id @default(uuid())
  code        String              @unique
  name        String
  description String?
  roleAccess  RoleAppPermission[]
  users       UserAppPermission[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RoleAppPermission {
  roleId    String
  appId     String
  canAccess Boolean @default(true)

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  app  App  @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@id([roleId, appId])
}

model UserAppPermission {
  userId     String
  appId      String
  canAccess  Boolean @default(true)
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  app  App  @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@id([userId, appId])
}

model BonusCard {
  id               String   @id @default(uuid())
  workDate         DateTime
  bonus            String
  bonusName        String
  agentCode        String
  agentName        String
  companyCode      String   @default("")
  guide            String
  guideName        String
  memberCode       String   @default("")
  supervisorCode   String   @default("")
  partyCode        String
  nation           String   @default("CN")
  province         String   @default("")
  adult            Int      @default(0)
  child            Int      @default(0)
  tourLeader       Int      @default(0)
  student          Int      @default(0)
  carCode          String   @default("")
  shop             String   @default("")
  charterCode      String   @default("")
  hotel            String   @default("")
  comeFrom         String   @default("")
  busType          String   @default("")
  tourIn           String   @default("")
  tourOut          String   @default("")
  comment          String   @default("")
  imageUrl         String?
  nameListCode     String   @default("")
  extraGuides      Json     @default("[]")
  narratorGroup    String   @default("")
  narratorPax      Int      @default(0)
  narrators        Json     @default("[]")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Member {
  id                     String    @id @default(uuid())
  guideCode              String    @unique
  titleTh                String    @default("")
  firstNameTh            String    @default("")
  lastNameTh             String    @default("")
  titleEn                String    @default("")
  firstNameEn            String    @default("")
  lastNameEn             String    @default("")
  phone                  String    @default("")
  nickname               String    @default("")
  birthDate              DateTime?
  nationalId             String    @default("")
  cardIssueDate          DateTime?
  cardExpireDate         DateTime?
  guideType              String    @default("")
  guideLicenseNo         String    @default("")
  guideLicenseExpireDate DateTime?
  passportNo             String    @default("")
  address                String    @default("")
  province               String    @default("")
  note                   String    @default("")
  recorder               String    @default("")
  fullName               String    @default("")
  fullNameTh             String    @default("")
  guideCardNo            String    @default("")
  company                String    @default("")
  guideHo                String    @default("")
  imageUrl               String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

model Agent {
  id            String       @id @default(uuid())
  agentCode     String       @unique
  codeCenter    String       @default("")
  name          String       @default("")
  address       String       @default("")
  nation        String       @default("")
  phone         String       @default("")
  fax           String       @default("")
  contactPerson String       @default("")
  marketing     String       @default("")
  agentHO       String       @default("")
  typeCenter    String       @default("")
  agentType     String       @default("AGENT")
  typeGroup     String       @default("")
  navCode       String       @default("")
  email         String       @default("")
  taxId         String       @default("")
  branch        String       @default("")
  bankName      String       @default("")
  bankBranch    String       @default("")
  bankAccount   String       @default("")
  active        Boolean      @default(true)
  aliases       AgentAlias[]
  matchings     AgentMatching[]
  bookings      Booking[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([name])
  @@index([nation])
  @@index([active])
  @@index([typeGroup])
}

model AgentAlias {
  id        String   @id @default(uuid())
  agentId   String
  pattern   String
  matchType String   @default("contains")
  createdAt DateTime @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, pattern, matchType])
  @@index([pattern])
}

model AgentMatching {
  id           String   @id @default(uuid())
  agentCodeRef String   @unique
  agentNameRef String   @default("")
  agentId      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([agentNameRef])
}

model NameList {
  id          String         @id @default(uuid())
  code        String         @unique
  partyCode   String         @default("")
  arriveDate  DateTime?
  departDate  DateTime?
  agentCode   String         @default("")
  agentName   String         @default("")
  guideCode   String         @default("")
  guideName   String         @default("")
  nationCode  String         @default("")
  nationName  String         @default("")
  country     String         @default("")
  province    String         @default("")
  busCode     String         @default("")
  pax         Int            @default(0)
  sourceFile  String         @default("")
  note        String         @default("")
  items       NameListItem[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([arriveDate])
  @@index([agentCode])
  @@index([partyCode])
  @@index([nationCode])
}

model NameListItem {
  id           String   @id @default(uuid())
  nameListId   String
  itemNo       Int      @default(0)
  isLeader     Boolean  @default(false)
  agentCode    String   @default("")
  code         String   @default("")
  arriveDate   DateTime?
  passportNo   String   @default("")
  firstName    String   @default("")
  lastName     String   @default("")
  birthDate    DateTime?
  age          Int?
  gender       String   @default("")
  nationCode   String   @default("")
  province     String   @default("")
  location     String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  nameList NameList @relation(fields: [nameListId], references: [id], onDelete: Cascade)

  @@index([nameListId])
  @@index([passportNo])
  @@index([code])
}

model Booking {
  id           String             @id @default(uuid())
  importKey    String             @unique @default(uuid())
  docDate      DateTime
  docTime      String             @default("")
  docNo        String             @default("")
  agentCode    String             @default("")
  agentId      String?
  agentName    String             @default("")
  partyCode    String             @default("")
  nation       String             @default("")
  arriveDate   DateTime?
  departDate   DateTime?
  guideCode    String             @default("")
  guideName    String             @default("")
  telGuide     String             @default("")
  telDriver    String             @default("")
  pax          Int                @default(0)
  carCode      String             @default("")
  shop         String             @default("")
  bookRemark   String             @default("")
  dateBookJw   DateTime?
  timeBookJw   String             @default("")
  ptyStartDate DateTime?
  ptyEndDate   DateTime?
  faxNo        String             @default("")
  agentCodeRef String             @default("")
  partyCodeRef String             @default("")
  status       Boolean            @default(false)
  upload       Boolean            @default(false)
  references   BookingReference[]
  agent        Agent?             @relation(fields: [agentId], references: [id], onDelete: SetNull)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([docDate])
  @@index([agentCode])
  @@index([agentId])
  @@index([nation])
  @@index([status])
  @@index([upload])
}

model BookingReference {
  id        String    @id @default(uuid())
  bookingId String
  orderDate DateTime?
  faxNo     String    @default("")
  agentCode String    @default("")
  code      String    @default("")
  place     String    @default("")
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime  @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([faxNo])
}
